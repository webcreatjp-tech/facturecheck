# ============================================================
# Variables d'environnement – FactureCheck
# Copiez ce fichier en .env.local et renseignez les valeurs.
# NE JAMAIS commiter .env.local dans le dépôt.
# ============================================================

# ----------------------------------------------------------
# Supabase
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
# ----------------------------------------------------------

# URL publique du projet Supabase (sans slash final)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anonyme (anon/public) – exposable côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role – CONFIDENTIELLE, côté serveur uniquement
# Utilisée par les Server Actions pour bypasser le RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------
# Auth (T003+) – URL de redirection après confirmation email
# En local : http://localhost:3000
# En production : https://votre-domaine.com
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------
# OCR (T004) – Pipeline d'extraction de texte
# ----------------------------------------------------------

# Secret partagé protégeant la route interne /api/ocr/process
# Générez une valeur forte : openssl rand -hex 32
INTERNAL_OCR_SECRET=remplacer-par-une-valeur-forte-generee-aleatoirement

# -- Fournisseur Azure Form Recognizer (optionnel, pour PDFs scannés) --
# Laissez vide pour utiliser pdf-parse (PDFs texte uniquement)
# Dashboard Azure → Form Recognizer → Keys and Endpoint
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

# ----------------------------------------------------------
# Stripe (T007) – Facturation
# Dashboard Stripe → Developers → API keys
# ----------------------------------------------------------

# Clé secrète Stripe – CONFIDENTIELLE, côté serveur uniquement
STRIPE_SECRET_KEY=sk_test_...

# Clé publique Stripe – exposable côté client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret de signature du webhook – Dashboard Stripe → Webhooks → Endpoint → Signing secret
# Générer un endpoint pointant vers : https://votre-domaine.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs des prix Stripe (Dashboard Stripe → Products → Plan → Price)
# Créer un produit "Starter" à 9 €/mois et un produit "Pro" à 29 €/mois
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
