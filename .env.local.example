# ============================================================
# Variables d'environnement – FactureCheck
# Copiez ce fichier en .env.local et renseignez les valeurs.
# NE JAMAIS commiter .env.local dans le dépôt.
# ============================================================

# ----------------------------------------------------------
# Supabase
# Trouvez ces valeurs dans : Supabase Dashboard > Settings > API
# ----------------------------------------------------------

# URL publique du projet Supabase (sans slash final)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anonyme (anon/public) – exposable côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role – CONFIDENTIELLE, côté serveur uniquement
# Utilisée par les Server Actions pour bypasser le RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
